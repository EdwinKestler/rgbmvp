# =============================================================================
# rgbmvp — non-secret template
# Copy to .env and fill in local values. Never commit .env.
#   cp .env.example .env
# =============================================================================

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=info
# Network for public demos: liquid-testnet | liquid-regtest | bitcoin-testnet | bitcoin-signet
RGBMVP_NETWORK=liquid-testnet

# --- Project memory (optional Redis discovery cache; not asset storage) ---
# Default matches shared local Redis; no authentication.
RGBMVP_PROJECT_MEMORY_URL=redis://localhost:6379/0

# --- labd / API (Phase 0+) ---
# Operator default: loopback only. Public containers use PORT + LABD_PUBLIC_READ_ONLY=1.
LABD_BIND=127.0.0.1:8080
LABD_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Comma-separated CORS origins (no * when LABD_PUBLIC_READ_ONLY=1)
LABD_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# U4: public Internet posture — GET-only unless Bearer token presented
# LABD_PUBLIC_READ_ONLY=0
# LABD_API_TOKEN=
# LABD_MAX_BODY_BYTES=65536
# LABD_WEB_DIR=web
# LABD_ARTIFACTS_DIR=artifacts/public
# LABD_VERIFY_RATE_LIMIT=30

# --- Liquid (LWK / Elements) ---
# Prefer light clients for testnet; leave ELEMENTS_RPC_* empty unless you run a node.
LWK_NETWORK=testnet
# Electrum / Esplora endpoints (override if you use custom infra)
# Host:port for Electrum (TLS default on). Examples:
# LWK_ELECTRUM_URL=elements-testnet.blockstream.info:50002
# LWK_ELECTRUM_TLS=true
# LWK_ELECTRUM_VALIDATE_DOMAIN=true
# Esplora tip height URL used by `rgbmvp net status`:
# LWK_ESPLORA_TIP_URL=https://blockstream.info/liquidtestnet/api/blocks/tip/height
# Optional full node (not required for Phase 0 light mode)
# ELEMENTS_RPC_URL=http://127.0.0.1:18884
# ELEMENTS_RPC_USER=
# ELEMENTS_RPC_PASSWORD=

# --- P2 regtest: Elements with Simplicity (docker-compose default) ---
# ./scripts/regtest_simplicity.sh up  → host port 7042
# Credentials are regtest-only (match docker/elements-simplicity.conf). Never use on mainnet.
ELEMENTS_SIMPLICITY_RPC_URL=http://127.0.0.1:7042
ELEMENTS_RPC_USER=user
ELEMENTS_RPC_PASSWORD=pass
# Optional non-Simplicity Elements regtest (compose profile rgb-regtest, port 7041)
# ELEMENTS_RPC_URL=http://127.0.0.1:7041

# --- Bitcoin testnet (P1 HTLC / RGB twin swap) ---
BTC_NETWORK=testnet
BTC_ESPLORA_URL=https://blockstream.info/testnet/api
BTC_TESTNET_EXPLORER=https://blockstream.info/testnet
# Public address for btc-alice (safe to share on testnet)
# BTC_TESTNET_ADDRESS=tb1q…
# WIF for btc-alice — NEVER commit real values; only in local .env
# BTC_TESTNET_WIF=
# Optional bitcoind (not required if using Esplora broadcast)
# BITCOIN_RPC_URL=
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASSWORD=

# --- Optional lwk_cli JSON-RPC (if you run `lwk_cli server start`) ---
LWK_CLI_RPC_URL=http://127.0.0.1:32111

# --- Paths (local only; keep under gitignored dirs) ---
RGBMVP_DATA_DIR=.rgbmvp
RGBMVP_WALLET_DIR=.rgbmvp/wallets
RGBMVP_CONSIGNMENT_DIR=.rgbmvp/consignments

# --- Secrets (put real values only in .env — never commit) ---
# Demo faucet / issuer hot keys for TESTNET ONLY. Empty = disabled.
# RGBMVP_FAUCET_MNEMONIC=
# RGBMVP_ISSUER_MNEMONIC=
# --- Explorers (public links only) ---
LIQUID_TESTNET_EXPLORER=https://blockstream.info/liquidtestnet
BITCOIN_TESTNET_EXPLORER=https://blockstream.info/testnet

# --- T1: bounded public demo swaps (docs/TESTNET_PUBLIC_SWAPS.md) ---
# OFF by default. When enabled, POST /v1/demo/swap lets a visitor trigger ONE
# real testnet HTLC swap between the lab's own wallets. All protocol parameters
# are fixed server-side; the visitor supplies only a bot-check token.
# TESTNET ONLY — mainnet is refused at config load regardless of this flag.
# LABD_DEMO_SWAPS=1

# Bot protection (Cloudflare Turnstile). Verification FAILS CLOSED: with
# LABD_DEMO_TURNSTILE_REQUIRED unset/true and no secret set, every request is
# refused. Only set REQUIRED=0 for local testing, never in public deployment.
# LABD_DEMO_TURNSTILE_SECRET=
# LABD_DEMO_TURNSTILE_REQUIRED=1

# Wallets the demo swaps between (never visitor-supplied).
# LABD_DEMO_BTC_WALLET=btc-alice
# LABD_DEMO_LQ_WALLET=bob

# Swap size and fees. leg_sats is clamped to 5000 no matter what is set here.
# The BTC leg spends two txs (fund + claim), so keep MAX_FEE >= 2x BTC_FEE.
# Fees default to the repo's proven action values. An earlier T1 draft used
# ~200 sats from vbyte arithmetic (~1.4 sat/vB) which risks sitting
# unconfirmed. Measure on a live run before lowering these.
# LABD_DEMO_LEG_SATS=1000
# LABD_DEMO_BTC_FEE_SATS=800
# LABD_DEMO_BTC_CLAIM_FEE_SATS=500
# LABD_DEMO_LQ_FEE_SATS=300
# LABD_DEMO_CSV_DELAY=6

# Spend budget. BTC testnet is the scarce side (faucets are slow), so the whole
# demo is sized around BTC fee burn: 28000 / 1300 = ~21 swaps for the run.
# MAX_FEE must be >= BTC_FEE + BTC_CLAIM_FEE or the budget under-reserves
# (labd warns at startup if it is).
# LABD_DEMO_FEE_BUDGET_SATS=28000
# LABD_DEMO_MAX_FEE_SATS=1300

# Rate/abuse limits.
# LABD_DEMO_DAILY_CAP=6
# LABD_DEMO_MAX_CONCURRENT=1
# LABD_DEMO_MIN_INTERVAL_SECS=600
# LABD_DEMO_PER_IP_HOURLY=1
# LABD_DEMO_PER_IP_DAILY=2

# Float floors — below these the demo pauses (503) awaiting a faucet refill.
# LABD_DEMO_BTC_FLOOR_SATS=5000
# LABD_DEMO_LQ_FLOOR_SATS=20000

# Per-IP quotas behind a proxy: set to 1 ONLY when exactly one trusted proxy
# (e.g. Cloud Run) fronts labd. The rightmost X-Forwarded-For entry is then the
# real client. Leave unset to use the unspoofable socket peer address.
# LABD_TRUST_XFF=1

# W4 — budget persistence. Counters are written to
# $RGBMVP_DATA_DIR/demo_budget.json after every swap. For a real deployment
# RGBMVP_DATA_DIR MUST point at a persistent volume: on ephemeral storage a
# restart resets the spend ceiling and the run can overshoot its fee budget.

# W5 — refund/recycle watcher. Refunds free the value from the HTLC; the SWEEP
# is what returns it to the funding wallet, so that together only fees burn. The
# refund path is consensus-gated on csv_delay confirmations, so sweeping sooner
# than ~csv_delay blocks just produces rejected broadcasts (harmless, retried).
# Only ids minted by the demo endpoint (demo-<epoch>-<seq>) are ever swept.
# The watcher ALSO sweeps the four demo exit addresses back to the funding
# wallet: HTLC claims and refunds pay P2WPKH(sha256(<label>)), NOT the funder,
# so without the sweep btc-alice drains on every swap.
# Manual equivalent: rgbmvp btc demo-exits ; rgbmvp btc sweep-demo --to btc-alice
# LABD_DEMO_SWEEP_INTERVAL_SECS=900
# LABD_DEMO_SWEEP_MIN_AGE_SECS=5400
